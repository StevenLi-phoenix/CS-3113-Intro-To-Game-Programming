+void Level1::rebuildNavIfDirty()
+{
+    if (!mNavMapDirty)
+    {
+        return;
+    }
+    rebuildNavMapWithObstacles();
+}
+
+void Level1::rebuildNavMapWithObstacles()
+{
+    std::vector<Entity*> obstacles;
+    obstacles.reserve(mCollidableEntities.size());
+
+    for (Entity* entity : mCollidableEntities)
+    {
+        if (!entity || !entity->getIsActive() || !entity->getCanCollide())
+        {
+            continue;
+        }
+        if (entity == mPlayer)
+        {
+            continue;
+        }
+        if (std::find(mEnemies.begin(), mEnemies.end(), entity) != mEnemies.end())
+        {
+            continue;
+        }
+        obstacles.push_back(entity);
+    }
+
+    const float agentRadius = 0.0f;
+
+    const double tNavStart = GetTime();
+    mNavMap.build(mLevelData.data(),
+                  mMapColumns,
+                  mMapRows,
+                  mTileSize,
+                  getChunkStartX(),
+                  getChunkStartY(),
+                  obstacles,
+                  agentRadius);
+    const double tNavEnd = GetTime();
+    if (isDebugMode())
+    {
+        LOG_DEBUG(TextFormat("NavMap build chunkStart=(%d,%d) size=%dx%d obstacles=%zu agentRadius=%.1f took=%.2fms",
+                             getChunkStartX(),
+                             getChunkStartY(),
+                             mMapColumns,
+                             mMapRows,
+                             obstacles.size(),
+                             agentRadius,
+                             (tNavEnd - tNavStart) * 1000.0));
+    }
+    mNavMapDirty = false;
+}
