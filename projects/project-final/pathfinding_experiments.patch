+void NavMap::rasterizeObstacles(const std::vector<Entity*> &obstacles,
+                                float padding,
+                                std::vector<uint8_t> &walkable) const
+{
+    if (obstacles.empty() || mColumns <= 0 || mRows <= 0 || mTileSize <= 0.0f)
+    {
+        return;
+    }
+
+    const float appliedPadding = std::max(padding, 0.0f);
+
+    for (const Entity* entity : obstacles)
+    {
+        if (!entity || !entity->getCanCollide() || !entity->getIsActive())
+        {
+            continue;
+        }
+
+        const Vector2 colliderSize = entity->getColliderDimensions();
+        if (colliderSize.x <= 0.0f || colliderSize.y <= 0.0f)
+        {
+            continue;
+        }
+
+        const Vector2 pos = entity->getPosition();
+        const float halfWidth = colliderSize.x * 0.5f + appliedPadding;
+        const float halfHeight = colliderSize.y * 0.5f + appliedPadding;
+
+        const float minWorldX = pos.x - halfWidth;
+        const float maxWorldX = pos.x + halfWidth;
+        const float minWorldY = pos.y - halfHeight;
+        const float maxWorldY = pos.y + halfHeight;
+
+        int minGridX = static_cast<int>(std::floor(minWorldX / mTileSize)) - mChunkStartX;
+        int maxGridX = static_cast<int>(std::floor(maxWorldX / mTileSize)) - mChunkStartX;
+        int minGridY = static_cast<int>(std::floor(minWorldY / mTileSize)) - mChunkStartY;
+        int maxGridY = static_cast<int>(std::floor(maxWorldY / mTileSize)) - mChunkStartY;
+
+        minGridX = std::max(0, minGridX);
+        minGridY = std::max(0, minGridY);
+        maxGridX = std::min(mColumns - 1, maxGridX);
+        maxGridY = std::min(mRows - 1, maxGridY);
+
+        for (int y = minGridY; y <= maxGridY; ++y)
+        {
+            for (int x = minGridX; x <= maxGridX; ++x)
+            {
+                const int idx = toIndex(x, y);
+                if (idx >= 0)
+                {
+                    walkable[static_cast<size_t>(idx)] = 0;
+                }
+            }
+        }
+    }
+}
