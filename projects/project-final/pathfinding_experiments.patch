+
+bool NavMap::findNearestWalkable(int gridX,
+                                 int gridY,
+                                 const std::vector<uint8_t> &walkable,
+                                 int &outX,
+                                 int &outY,
+                                 int maxRadius) const
+{
+    if (walkable.empty() || maxRadius <= 0)
+    {
+        return false;
+    }
+
+    if (isWalkable(walkable, gridX, gridY))
+    {
+        outX = gridX;
+        outY = gridY;
+        return true;
+    }
+
+    const int totalNodes = mColumns * mRows;
+    if (totalNodes <= 0 || gridX < 0 || gridX >= mColumns || gridY < 0 || gridY >= mRows)
+    {
+        return false;
+    }
+
+    struct Node { int x; int y; int dist; };
+    std::queue<Node> q;
+    std::vector<uint8_t> visited(static_cast<size_t>(totalNodes), 0);
+
+    const int startIndex = toIndex(gridX, gridY);
+    if (startIndex < 0)
+    {
+        return false;
+    }
+    visited[static_cast<size_t>(startIndex)] = 1;
+    q.push({gridX, gridY, 0});
+
+    // Use cardinal directions to expand evenly outward
+    const int kOffsets[4][2] = {
+        {1, 0},
+        {-1, 0},
+        {0, 1},
+        {0, -1}
+    };
+
+    while (!q.empty())
+    {
+        Node current = q.front();
+        q.pop();
+
+        const int nextDist = current.dist + 1;
+        if (nextDist > maxRadius)
+        {
+            continue;
+        }
+
+        for (const auto &offset : kOffsets)
+        {
+            const int nx = current.x + offset[0];
+            const int ny = current.y + offset[1];
+            const int nIndex = toIndex(nx, ny);
+            if (nIndex < 0 || visited[static_cast<size_t>(nIndex)])
+            {
+                continue;
+            }
+            visited[static_cast<size_t>(nIndex)] = 1;
+
+            if (isWalkable(walkable, nx, ny))
+            {
+                outX = nx;
+                outY = ny;
+                return true;
+            }
+
+            q.push({nx, ny, nextDist});
+        }
+    }
+
+    return false;
 }
 
+std::vector<Vector2> NavMap::findPathWithMask(const Vector2 &worldStart,
+                                              const Vector2 &worldGoal,
+                                              float clearance,
+                                              const std::vector<Entity*> &blockers,
+                                              bool *usedFallback,
+                                              bool *throttled) const
+{
+    if (!consumeBudget(throttled))
+    {
+        return {};
+    }
+
+    if (!hasData())
+    {
+        return {};
+    }
+
+    std::vector<uint8_t> masked = mWalkable;
+    rasterizeObstacles(blockers, clearance, masked);
+    std::vector<float> futureCosts(masked.size(), 0.0f);
+    buildFutureCosts(blockers, futureCosts);
+    return findPathWithWalkable(worldStart, worldGoal, masked, usedFallback, &futureCosts);
+}
+
+bool NavMap::findClosestWalkableByDistance(int gridX,
+                                           int gridY,
+                                           const std::vector<uint8_t> &walkable,
+                                           int &outX,
+                                           int &outY) const
+{
+    if (walkable.empty() || mColumns <= 0 || mRows <= 0)
+    {
+        return false;
+    }
+
+    int bestX = -1;
+    int bestY = -1;
+    int bestDistSq = std::numeric_limits<int>::max();
+
+    for (int y = 0; y < mRows; ++y)
+    {
+        for (int x = 0; x < mColumns; ++x)
+        {
+            const int idx = toIndex(x, y);
+            if (idx < 0 || !isWalkable(walkable, x, y))
+            {
+                continue;
+            }
+
+            const int dx = x - gridX;
+            const int dy = y - gridY;
+            const int distSq = dx * dx + dy * dy;
+            if (distSq < bestDistSq)
+            {
+                bestDistSq = distSq;
+                bestX = x;
+                bestY = y;
+            }
+        }
+    }
+
+    if (bestX < 0 || bestY < 0)
+    {
+        return false;
+    }
+
+    outX = bestX;
+    outY = bestY;
+    return true;
+}
+
+bool NavMap::consumeBudget(bool *throttled) const
+{
+    if (mRequestsThisFrame >= mMaxRequestsPerFrame)
+    {
+        if (throttled)
+        {
+            *throttled = true;
+        }
+        return false;
+    }
+    ++mRequestsThisFrame;
+    return true;
+}
+
+void NavMap::cacheDebugPath(const std::vector<Vector2> &path, Color color) const
+{
+    if (path.size() < 2)
+    {
+        return;
+    }
+
+    const size_t maxPaths = 64;
+    if (mDebugPaths.size() >= maxPaths)
+    {
+        mDebugPaths.erase(mDebugPaths.begin());
+    }
+
+    DebugPath entry;
+    entry.nodes = path;
+    entry.color = color;
+    mDebugPaths.push_back(std::move(entry));
+}
+
+void NavMap::debugRender() const
+{
+    if (!isDebugMode() || mDebugPaths.empty())
+    {
+        return;
+    }
+
+    const float thickness = 2.0f;
+    for (const DebugPath &entry : mDebugPaths)
+    {
+        if (entry.nodes.size() < 2)
+        {
+            continue;
+        }
+        for (size_t i = 1; i < entry.nodes.size(); ++i)
+        {
+            DrawLineEx(entry.nodes[i - 1], entry.nodes[i], thickness, entry.color);
+        }
+    }
 
+    // Only keep paths generated this frame; clear history after drawing.
+    mDebugPaths.clear();
+}
+
+void NavMap::clearDebugPaths() const
+{
+    mDebugPaths.clear();
+}
+
+void NavMap::addDebugPath(const std::vector<Vector2> &path, Color color) const
+{
+    cacheDebugPath(path, color);
+}
+
+void NavMap::beginFrame()
+{
+    mRequestsThisFrame = 0;
+}
+
+void NavMap::setMaxRequestsPerFrame(int maxRequests)
+{
+    mMaxRequestsPerFrame = std::max(1, maxRequests);
+}
+void NavMap::buildFutureCosts(const std::vector<Entity*> &blockers,
+                              std::vector<float> &futureCosts,
+                              float timeStep,
+                              int steps) const
+{
+    if (futureCosts.empty() || !hasData() || steps <= 0)
+    {
+        return;
+    }
+
+    const float weights[] = {16.0f, 8.0f, 4.0f, 2.0f, 1.0f};
+    const int weightCount = static_cast<int>(sizeof(weights) / sizeof(weights[0]));
+
+    for (const Entity* entity : blockers)
+    {
+        if (!entity || !entity->getIsActive())
+        {
+            continue;
+        }
+        Vector2 pos = entity->getPosition();
+        Vector2 vel = entity->getVelocity();
+
+        for (int k = 1; k <= steps; ++k)
+        {
+            const float t = timeStep * static_cast<float>(k);
+            Vector2 predict = {
+                pos.x + vel.x * t,
+                pos.y + vel.y * t
+            };
+
+            int gx = 0;
+            int gy = 0;
+            if (!worldToGrid(predict, gx, gy))
+            {
+                continue;
+            }
+            const int idx = toIndex(gx, gy);
+            if (idx < 0)
+            {
+                continue;
+            }
+
+            const int weightIndex = std::min(k - 1, weightCount - 1);
+            futureCosts[static_cast<size_t>(idx)] += weights[weightIndex];
+        }
+    }
+}
