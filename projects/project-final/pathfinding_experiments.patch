+Vector2 Dog::separationSteer(const std::vector<Entity*> &blockers) const
+{
+    Vector2 force = {0.0f, 0.0f};
+    const float radius = std::max(getColliderClearanceRadius() * 2.0f, 1.0f);
+    const float radiusSq = radius * radius;
+
+    for (Entity* entity : blockers)
+    {
+        if (!entity || entity == this || !entity->getIsActive() || !entity->getCanCollide())
+        {
+            continue;
+        }
+        Vector2 delta = {
+            getPosition().x - entity->getPosition().x,
+            getPosition().y - entity->getPosition().y
+        };
+        const float distSq = delta.x * delta.x + delta.y * delta.y;
+        if (distSq <= 0.0001f || distSq > radiusSq)
+        {
+            continue;
+        }
+        const float dist = sqrtf(distSq);
+        Vector2 away = {
+            delta.x / dist,
+            delta.y / dist
+        };
+        const float weight = 1.0f - (dist / radius);
+        force.x += away.x * weight;
+        force.y += away.y * weight;
+    }
+
+    return force;
+}
+
+Vector2 Dog::applySteering(const Vector2 &baseVelocity, const Vector2 &steer) const
+{
+    const float steerStrength = 30.0f;
+    Vector2 vel = {
+        baseVelocity.x + steer.x * steerStrength,
+        baseVelocity.y + steer.y * steerStrength
+    };
+
+    // Light damping to avoid jitter
+    vel.x *= 0.98f;
+    vel.y *= 0.98f;
+
+    const float speed = Vector2Length(vel);
+    const float maxSpeed = mChaseSpeed;
+    if (speed > maxSpeed && speed > 0.0001f)
+    {
+        vel.x = vel.x / speed * maxSpeed;
+        vel.y = vel.y / speed * maxSpeed;
+    }
+
+    return vel;
+}
+std::vector<Vector2> Dog::activePathPoints() const
+{
+    std::vector<Vector2> points;
+    if (!hasActivePath())
+    {
+        return points;
+    }
+
+    // Include current position so the rendered polyline starts from the dog.
+    points.reserve(mCurrentPath.size() - mCurrentPathIndex + 1);
+    points.push_back(getPosition());
+    for (size_t i = mCurrentPathIndex; i < mCurrentPath.size(); ++i)
+    {
+        points.push_back(mCurrentPath[i]);
+    }
+    return points;
+}
+
+Vector2 Dog::currentPathTarget() const
+{
+    if (!hasActivePath())
+    {
+        return getPosition();
+    }
+    return mCurrentPath.back();
+}
